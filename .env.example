# ===== OPENAI CONFIGURATION =====
# Get your API key from: https://platform.openai.com/api-keys
# NEVER commit real keys to Git! Keep them in .env only (which is in .gitignore)

OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ===== AZURE OPENAI (OPTIONAL ALTERNATIVE) =====
# If OpenAI.com is blocked, you can use Azure OpenAI instead

USE_AZURE_OPENAI=false
AZURE_OPENAI_API_KEY=your_azure_api_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# ===== RAILWAY DEPLOYMENT =====
# For Railway deployment:
# 1. Go to Railway Dashboard > Your Service > Variables tab
# 2. Add: OPENAI_API_KEY = (paste your real key from .env file)
# 3. Redeploy the service
# 4. Check deployment logs for: "✓ OpenAI API connection verified"
#
# IMPORTANT: Railway uses dashboard Variables, NOT this .env.example file!
